# Database Configuration
# SQLite (Recommended for local development)
USE_SQLITE=true
SQLITE_DB_PATH=data/stock_signals.db

# Supabase (For cloud storage)
# Uncomment and fill in to use Supabase instead of SQLite
# USE_SQLITE=false
# SUPABASE_URL=your_supabase_url
# SUPABASE_KEY=your_supabase_anon_key

# Data Source Configuration
# Options: akshare, sina_finance, eastmoney
DEFAULT_DATA_SOURCE=akshare

# Signal Detection Parameters
# Volume ratio threshold (default: 0.2)
THRESHOLD_VOLUME_RATIO=0.2

# Price change threshold (default: 0.05 = 5%)
THRESHOLD_PRICE_CHANGE=0.05

# Lookback days for historical data (default: 20)
LOOKBACK_DAYS=20

# Note: Copy this file to .env and fill in your values
# DO NOT commit .env to version control!
